<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\ZTR.Models\ZTR.Models.csproj" />
    <ProjectReference Include="..\ZTR.Common\ZTR.Common.csproj" />
    <ProjectReference Include="..\ZTR.HAL\ZTR.HAL.csproj" />
    <ProjectReference Include="..\ZTR.Intelligence\ZTR.Intelligence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ZTR.Api.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <FrontendDir>..\..\frontend</FrontendDir>
    <FrontendBuildDir>$(FrontendDir)\dist</FrontendBuildDir>
  </PropertyGroup>

  <Target Name="BuildFrontend" BeforeTargets="Build" Condition="'$(BuildFrontend)' == 'true'">
    <Message Text="Building frontend..." Importance="high" />
    <Exec Command="npm ci" WorkingDirectory="$(FrontendDir)" StandardOutputImportance="normal" />
    <Exec Command="npm run build" WorkingDirectory="$(FrontendDir)" StandardOutputImportance="normal" />
  </Target>

  <ItemGroup>
    <Content Include="$(FrontendBuildDir)\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TargetPath>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
      <ExcludeFromSingleFile>false</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

</Project>
