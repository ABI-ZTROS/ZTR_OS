<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\ZTR.Models\ZTR.Models.csproj" />
    <ProjectReference Include="..\ZTR.Common\ZTR.Common.csproj" />
    <ProjectReference Include="..\ZTR.HAL\ZTR.HAL.csproj" />
    <ProjectReference Include="..\ZTR.Intelligence\ZTR.Intelligence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageReference Include="System.Management" Version="10.0.11" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <TypeScriptCompileBlocked>true</TypeScriptCompileBlocked>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>1591</NoWarn>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <PublishAot>true</PublishAot>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ZTR.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="wwwroot\**\*.*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="EnsureWwwroot" BeforeTargets="Publish" Condition="'$(BuildFrontend)' != 'false' AND !Exists('$(MSBuildProjectDirectory)\wwwroot\index.html')">
    <PropertyGroup>
      <_FrontendDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\frontend'))</_FrontendDir>
      <_FrontendDistDir>$(_FrontendDir)\dist</_FrontendDistDir>
    </PropertyGroup>
    <MakeDir Directories="$(MSBuildProjectDirectory)\wwwroot" Condition="Exists('$(_FrontendDistDir)')" />
    <ItemGroup Condition="Exists('$(_FrontendDistDir)')">
      <_WwwrootPublishFiles Include="$(_FrontendDistDir)\**\*.*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(_WwwrootPublishFiles)"
      DestinationFolder="$(MSBuildProjectDirectory)\wwwroot\"
      Condition="Exists('$(_FrontendDistDir)')"
      SkipUnchangedFiles="false" />
  </Target>

</Project>
