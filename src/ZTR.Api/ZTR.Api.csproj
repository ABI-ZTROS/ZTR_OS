<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\ZTR.Models\ZTR.Models.csproj" />
    <ProjectReference Include="..\ZTR.Common\ZTR.Common.csproj" />
    <ProjectReference Include="..\ZTR.HAL\ZTR.HAL.csproj" />
    <ProjectReference Include="..\ZTR.Intelligence\ZTR.Intelligence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageReference Include="System.Management" Version="10.0.11" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>1591</NoWarn>
    <BuildFrontend>true</BuildFrontend>
    <CopyFrontend>true</CopyFrontend>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ZTR.Api.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <FrontendDir>..\..\frontend</FrontendDir>
    <FrontendBuildDir>$(FrontendDir)\dist</FrontendBuildDir>
    <WwwRootDir>wwwroot</WwwRootDir>
  </PropertyGroup>

  <Target Name="EnsureFrontendNodeModules" BeforeTargets="BuildFrontend"
          Condition="Exists('$(FrontendDir)\package.json') And !Exists('$(FrontendDir)\node_modules\typescript\package.json')">
    <Message Text="📦 [EnsureFrontendNodeModules] 检测到 node_modules 缺失，正在执行 npm install..." Importance="high" />
    <Exec Command="npm.cmd install"
          WorkingDirectory="$(FrontendDir)"
          ContinueOnError="false"
          StandardOutputImportance="high"
          StandardErrorImportance="high" />
  </Target>

  <Target Name="BuildFrontend" BeforeTargets="Build" DependsOnTargets="EnsureFrontendNodeModules"
          Condition="'$(BuildFrontend)' == 'true' And Exists('$(FrontendDir)\package.json')">
    <Message Text="🌐 [ZTR.Api] 开始前端构建..." Importance="high" />
    <Exec Command="npm.cmd run build"
          WorkingDirectory="$(FrontendDir)"
          ContinueOnError="false"
          StandardOutputImportance="high"
          StandardErrorImportance="high" />
  </Target>

  <Target Name="CopyFrontendToWwwroot" AfterTargets="Build" Condition="'$(CopyFrontend)' == 'true' And Exists('$(FrontendBuildDir)')">
    <Message Text="Copying frontend to wwwroot..." Importance="high" />
    <ItemGroup>
      <FrontendFiles Include="$(FrontendBuildDir)\**\*" />
    </ItemGroup>
    <RemoveDir Directories="$(WwwRootDir)" />
    <Copy SourceFiles="@(FrontendFiles)"
          DestinationFiles="@(FrontendFiles->'$(WwwRootDir)\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
