<Window x:Class="ZTR.Desktop.StartupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZTR_OS 启动中"
        Height="500"
        Width="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True">
    <Border Background="#1a1f2e" CornerRadius="16" Padding="32">
        <Border.Effect>
            <DropShadowEffect Color="#00d4ff" BlurRadius="40" ShadowDepth="0" Opacity="0.4"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Logo / Title -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,24">
                <TextBlock Text="ZTR_OS" FontSize="36" FontWeight="Bold"
                           Foreground="#00d4ff" TextAlignment="Center"/>
                <TextBlock Text="ASUS 性能调优平台" FontSize="14"
                           Foreground="#8892a6" TextAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Progress Bar -->
            <ProgressBar x:Name="ProgressBar" Grid.Row="1" Height="8"
                         Minimum="0" Maximum="100" Value="0"
                         Foreground="#00d4ff" Background="#2a3040"
                         BorderThickness="0"/>

            <!-- Status Text -->
            <TextBlock x:Name="StatusText" Grid.Row="2" Margin="0,12,0,16"
                       Text="正在初始化..." FontSize="13"
                       Foreground="#c0c8d0" TextAlignment="Center"/>

            <!-- Log Output -->
            <TextBox x:Name="LogOutput" Grid.Row="3" IsReadOnly="True"
                     TextWrapping="NoWrap" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     Background="#0a0e1a" Foreground="#00ff88"
                     FontFamily="Consolas" FontSize="11"
                     BorderThickness="0" Padding="8"
                     VerticalScrollBarVisibility="Auto"/>
        </Grid>
    </Border>
</Window>
