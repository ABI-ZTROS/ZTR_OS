<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>ZTR.Desktop</RootNamespace>
    <ApplicationIcon />
    <StartupObject />

    <FrontendDir>..\..\frontend</FrontendDir>
    <FrontendBuildDir>$(FrontendDir)\dist</FrontendBuildDir>
    <BuildFrontend>true</BuildFrontend>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZTR.Api\ZTR.Api.csproj" />
    <ProjectReference Include="..\ZTR.HAL\ZTR.HAL.csproj" />
    <ProjectReference Include="..\ZTR.Intelligence\ZTR.Intelligence.csproj" />
    <ProjectReference Include="..\ZTR.Models\ZTR.Models.csproj" />
    <ProjectReference Include="..\ZTR.Common\ZTR.Common.csproj" />
  </ItemGroup>

  <Target Name="EnsureFrontendBuilt" BeforeTargets="Build"
          Condition="'$(BuildFrontend)' == 'true'">
    <Message Text="Checking frontend build..." Importance="high" />
    <Exec Command="npm ci" WorkingDirectory="$(FrontendDir)" StandardOutputImportance="normal"
          Condition="!Exists('$(FrontendBuildDir)\index.html')" />
    <Exec Command="npm run build" WorkingDirectory="$(FrontendDir)" StandardOutputImportance="normal"
          Condition="!Exists('$(FrontendBuildDir)\index.html')" />
  </Target>

  <ItemGroup Condition="Exists('$(FrontendBuildDir)')">
    <Content Include="$(FrontendBuildDir)\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TargetPath>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </Content>
  </ItemGroup>

</Project>
